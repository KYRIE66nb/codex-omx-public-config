# Copy this file to ~/.config/codex/env and fill your own secrets.

export OPENAI_API_KEY="replace_me"

# Optional for scripts that still read OPENAI_BASE_URL from env.
# Codex itself reads the provider base URL from ~/.codex/config.toml.
export OPENAI_BASE_URL="https://tokenx24.com/v1"

export ANTHROPIC_AUTH_TOKEN="replace_me"
export ANTHROPIC_BASE_URL="https://claw.xclawxx.top"
export ANTHROPIC_MODEL="MiniMax-M2.7-highspeed"
export ANTHROPIC_REASONING_MODEL="MiniMax-M2.7-highspeed"
export ANTHROPIC_DEFAULT_OPUS_MODEL="MiniMax-M2.7-highspeed"
export ANTHROPIC_DEFAULT_SONNET_MODEL="MiniMax-M2.7-highspeed"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="MiniMax-M2.7-highspeed"

# Optional: OpenClaw notifications
export OPENCLAW_GATEWAY_URL="http://127.0.0.1:18789/hooks/wake"
export OPENCLAW_GATEWAY_TOKEN="replace_me"

